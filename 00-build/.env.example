# Copy to .env and fill in. .env is gitignored, never commit your key.

# Your Anthropic API key (console.anthropic.com).
ANTHROPIC_API_KEY=sk-ant-...

# Model + bounds. These ARE your M5 deliverable, tune and justify them.
CORTEX_MODEL=claude-sonnet-5-5  # a full run is ~cents to tens of cents
CORTEX_EFFORT=medium            # low | medium | high | xhigh | max (more = more thinking, more cost)
CORTEX_MAX_ITERATIONS=8       # loop cap: stop + escalate instead of spinning
CORTEX_MAX_REVISIONS=2        # critic<->drafter cap: stop the bounce-forever bomb
CORTEX_COST_CAP_USD=0.50      # hard spend cap per run, enforced outside the model
CORTEX_DAILY_CAP_USD=5.00     # hard spend cap per UTC day, across all runs (from run-log.jsonl)
CORTEX_TIMEOUT_S=90           # wall-clock cap per run; each model call times out too
CORTEX_MAX_QUEUE_ITEMS=10     # commitment cap: max backlog stories queued per run (all calls)

# Rough $ per 1M tokens for your chosen model (for the in-code cost estimate).
CORTEX_PRICE_IN_PER_M=2.00
CORTEX_PRICE_OUT_PER_M=10.00

# Kill switch: set CORTEX_KILL=1 (or create 00-build/KILL) and every run halts at its next step.
# CORTEX_KILL=1
